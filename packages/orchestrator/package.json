{
	"name": "@pi-chorus/orchestrator",
	"version": "0.1.0",
	"description": "Task decomposition, agent spawning, integration pipeline, and mission lifecycle",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@pi-chorus/agent-core": "^0.84.2",
		"@pi-chorus/ai": "^0.84.2",
		"@pi-chorus/coordination": "^0.1.0",
		"@pi-chorus/trace": "^0.1.0",
		"@pi-chorus/worktree": "^0.1.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}
